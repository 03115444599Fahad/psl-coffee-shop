@model PslCoffeeCms.Models.CmsDatabase
@{
    ViewData["Title"] = "CMS Dashboard";
    string activeTab = ViewBag.ActiveTab ?? "menu";
    var editItem = ViewBag.EditItem as PslCoffeeCms.Models.MenuItem;
    var settings = Model.Settings;
}

<div class="py-4">
    <div class="container">
        <!-- Top CMS Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center bg-psl-brown text-white p-4 rounded-4 shadow-sm mb-4">
            <div class="d-flex align-items-center gap-3">
                <img src="@settings.LogoUrl" alt="Logo" class="rounded-circle border border-warning" style="width: 56px; height: 56px; object-fit: cover;" />
                <div>
                    <span class="badge bg-warning text-dark mb-1">C# ASP.NET Core MVC CMS</span>
                    <h3 class="fw-bold mb-0 text-white">@settings.CompanyName — Content Management System</h3>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3 mt-lg-0">
                <button type="button" class="btn btn-warning fw-bold" data-bs-toggle="offcanvas" data-bs-target="#qaTestingDrawer" onclick="runCmsQaTests()">
                    <i class="bi bi-check2-all me-1"></i>Run QA Tests
                </button>
                <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-light">
                    <i class="bi bi-box-arrow-up-right me-1"></i>View Live Website
                </a>
                <form method="post" asp-controller="Admin" asp-action="ResetDefaults" class="d-inline" onsubmit="return confirm('Reset all CMS data back to PSL Web publish.doc defaults?');">
                    <button type="submit" class="btn btn-outline-warning">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Defaults
                    </button>
                </form>
                <a asp-controller="Admin" asp-action="Logout" class="btn btn-danger">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <div class="text-muted small">Total Menu Items</div>
                    <div class="fs-2 fw-bold" style="color: #5B3424;">@Model.MenuItems.Count</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <div class="text-muted small">Categories</div>
                    <div class="fs-2 fw-bold" style="color: #C58B52;">@Model.Categories.Count</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <div class="text-muted small">Hero Sliders</div>
                    <div class="fs-2 fw-bold text-success">@Model.Sliders.Count</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <div class="text-muted small">Active Deals</div>
                    <div class="fs-2 fw-bold text-primary">@Model.Deals.Count</div>
                </div>
            </div>
        </div>

        <!-- CMS Navigation Tabs -->
        <ul class="nav nav-pills gap-2 mb-4 bg-white p-2 rounded-4 shadow-sm">
            <li class="nav-item">
                <a class="nav-link @(activeTab == "menu" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-tab="menu">
                    <i class="bi bi-cup-hot-fill me-1"></i>Menu Items (@Model.MenuItems.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "categories" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-tab="categories">
                    <i class="bi bi-tags-fill me-1"></i>Categories (@Model.Categories.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "deals" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-tab="deals">
                    <i class="bi bi-stars me-1"></i>Deals (@Model.Deals.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "sliders" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-tab="sliders">
                    <i class="bi bi-images me-1"></i>Hero Sliders (@Model.Sliders.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "settings" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-tab="settings">
                    <i class="bi bi-gear-fill me-1"></i>Branding, About & Contact
                </a>
            </li>
        </ul>

        <!-- TAB 1: MENU ITEMS CRUD -->
        @if (activeTab == "menu")
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                        <h5 class="fw-bold mb-3">
                            <i class="bi @(editItem != null ? "bi-pencil-square" : "bi-plus-circle-fill") me-2"></i>
                            @(editItem != null ? $"Edit: {editItem.Name}" : "Add New Menu Item")
                        </h5>
                        <form method="post" asp-controller="Admin" asp-action="SaveMenuItem">
                            <input type="hidden" name="Id" value="@(editItem?.Id ?? "")" />
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Item Name</label>
                                <input type="text" name="Name" class="form-control form-control-sm" value="@(editItem?.Name ?? "")" placeholder="e.g. Spanish Latte" required />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-7">
                                    <label class="form-label small fw-semibold">Category</label>
                                    <select name="Category" class="form-select form-select-sm">
                                        @foreach (var cat in Model.Categories.OrderBy(c => c.DisplayOrder))
                                        {
                                            <option value="@cat.Name" selected="@(editItem?.Category == cat.Name)">@cat.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-5">
                                    <label class="form-label small fw-semibold">Price (@settings.Currency)</label>
                                    <input type="number" step="1" name="Price" class="form-control form-control-sm" value="@(editItem?.Price ?? 499)" required />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Description</label>
                                <textarea name="Description" rows="2" class="form-control form-control-sm" placeholder="Item description...">@(editItem?.Description ?? "")</textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Image URL</label>
                                <input type="text" name="ImageUrl" class="form-control form-control-sm" value="@(editItem?.ImageUrl ?? "https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80")" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Badge (optional)</label>
                                <input type="text" name="Badge" class="form-control form-control-sm" value="@(editItem?.Badge ?? "")" placeholder="e.g. Bestseller, Signature" />
                            </div>
                            <div class="d-flex gap-3 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Available" value="true" id="chkAvail" checked="@(editItem?.Available ?? true)" />
                                    <label class="form-check-label small" for="chkAvail">In Stock</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Featured" value="true" id="chkFeat" checked="@(editItem?.Featured ?? false)" />
                                    <label class="form-check-label small" for="chkFeat">Featured on Home</label>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-psl-primary btn-sm w-100">
                                    <i class="bi bi-save me-1"></i>@(editItem != null ? "Update Item" : "Add Item")
                                </button>
                                @if (editItem != null)
                                {
                                    <a asp-action="Index" asp-route-tab="menu" class="btn btn-outline-secondary btn-sm">Cancel</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold mb-3">All Menu Items (@Model.MenuItems.Count)</h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Item</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.MenuItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <img src="@item.ImageUrl" alt="@item.Name" class="rounded-2" style="width: 38px; height: 38px; object-fit: cover;" />
                                                    <div>
                                                        <div class="fw-bold">@item.Name</div>
                                                        @if (item.Featured)
                                                        {
                                                            <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Featured</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-secondary bg-opacity-25 text-dark">@item.Category</span></td>
                                            <td class="fw-bold">@settings.Currency @item.Price</td>
                                            <td>
                                                <form method="post" asp-action="ToggleAvailability" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm @(item.Available ? "btn-outline-success" : "btn-outline-danger") py-0 px-2">
                                                        @(item.Available ? "In Stock" : "Sold Out")
                                                    </button>
                                                </form>
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="Index" asp-route-tab="menu" asp-route-editId="@item.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form method="post" asp-action="DeleteMenuItem" class="d-inline" onsubmit="return confirm('Delete @item.Name?');">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- TAB 2: CATEGORIES -->
        @if (activeTab == "categories")
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold mb-3">Add / Update Category</h5>
                        <form method="post" asp-action="SaveCategory">
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Category Name</label>
                                <input type="text" name="Name" class="form-control form-control-sm" placeholder="e.g. Desserts" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Bootstrap Icon Class</label>
                                <input type="text" name="Icon" class="form-control form-control-sm" value="bi-cup-hot-fill" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Display Order</label>
                                <input type="number" name="DisplayOrder" class="form-control form-control-sm" value="@(Model.Categories.Count + 1)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Description</label>
                                <textarea name="Description" rows="2" class="form-control form-control-sm"></textarea>
                            </div>
                            <button type="submit" class="btn btn-psl-primary btn-sm w-100">Save Category</button>
                        </form>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold mb-3">Menu Categories (@Model.Categories.Count)</h5>
                        <div class="table-responsive">
                            <table class="table align-middle small">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Category</th>
                                        <th>Description</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.Categories.OrderBy(x => x.DisplayOrder))
                                    {
                                        <tr>
                                            <td>@c.DisplayOrder</td>
                                            <td class="fw-bold"><i class="bi @c.Icon me-1"></i>@c.Name</td>
                                            <td class="text-muted">@c.Description</td>
                                            <td>
                                                <form method="post" asp-action="DeleteCategory" onsubmit="return confirm('Delete category @c.Name?');">
                                                    <input type="hidden" name="id" value="@c.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- TAB 3: DEALS -->
        @if (activeTab == "deals")
        {
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold mb-3">Add / Update Special Deal</h5>
                        <form method="post" asp-action="SaveDeal">
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Deal Title</label>
                                <input type="text" name="title" class="form-control form-control-sm" placeholder="e.g. OFFICE DEAL" required />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Price (@settings.Currency)</label>
                                    <input type="number" name="price" class="form-control form-control-sm" value="1599" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Badge</label>
                                    <input type="text" name="badge" class="form-control form-control-sm" value="Special Combo" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Included Items (one per line)</label>
                                <textarea name="itemsMultiline" rows="4" class="form-control form-control-sm" placeholder="1 Coffee&#10;1 Sweet&#10;2 Mini Samosa&#10;French Fries" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-psl-primary btn-sm w-100">Save Deal</button>
                        </form>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="row g-3">
                        @foreach (var d in Model.Deals)
                        {
                            <div class="col-12">
                                <div class="card border-0 shadow-sm rounded-4 p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="fw-bold mb-0">@d.Title — <span class="text-success">@settings.Currency @d.Price</span></h5>
                                        <form method="post" asp-action="DeleteDeal">
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                    <ul class="small mb-0">
                                        @foreach (var line in d.Items)
                                        {
                                            <li>@line</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- TAB 4: SLIDERS -->
        @if (activeTab == "sliders")
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold mb-3">Add Hero Slider</h5>
                        <form method="post" asp-action="SaveSlider">
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Title</label>
                                <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Premium Coffee Experience" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Subtitle</label>
                                <textarea name="Subtitle" rows="3" class="form-control form-control-sm" required></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Badge</label>
                                <input type="text" name="Badge" class="form-control form-control-sm" value="PSL Coffee Bar • Pour, Sip & Leaf" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Image URL</label>
                                <input type="text" name="ImageUrl" class="form-control form-control-sm" value="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1000&q=80" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Display Order</label>
                                <input type="number" name="DisplayOrder" class="form-control form-control-sm" value="@(Model.Sliders.Count + 1)" />
                            </div>
                            <button type="submit" class="btn btn-psl-primary btn-sm w-100">Save Slider</button>
                        </form>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="row g-3">
                        @foreach (var s in Model.Sliders.OrderBy(x => x.DisplayOrder))
                        {
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                                    <img src="@s.ImageUrl" alt="@s.Title" style="height: 140px; object-fit: cover;" />
                                    <div class="card-body p-3">
                                        <span class="badge bg-secondary mb-1">Slide #@s.DisplayOrder</span>
                                        <h6 class="fw-bold">@s.Title</h6>
                                        <p class="small text-muted mb-2">@s.Subtitle</p>
                                        <form method="post" asp-action="DeleteSlider">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- TAB 5: SETTINGS (BRANDING, ABOUT US & CONTACT) -->
        @if (activeTab == "settings")
        {
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">Company Branding, About Us & Contact Settings</h5>
                <form method="post" asp-action="SaveSettings">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Company Name</label>
                            <input type="text" name="CompanyName" class="form-control" value="@settings.CompanyName" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Full Brand Subtitle</label>
                            <input type="text" name="BrandFull" class="form-control" value="@settings.BrandFull" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Currency Label</label>
                            <input type="text" name="Currency" class="form-control" value="@settings.Currency" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Call Phone Number</label>
                            <input type="text" name="Phone" class="form-control" value="@settings.Phone" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">WhatsApp Number (International)</label>
                            <input type="text" name="WhatsAppNumber" class="form-control" value="@settings.WhatsAppNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Location / Address</label>
                            <input type="text" name="Address" class="form-control" value="@settings.Address" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">About Us Heading</label>
                            <input type="text" name="AboutTitle" class="form-control" value="@settings.AboutTitle" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">About Us Paragraph 1</label>
                            <textarea name="AboutParagraph1" rows="2" class="form-control">@settings.AboutParagraph1</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">About Us Paragraph 2</label>
                            <textarea name="AboutParagraph2" rows="2" class="form-control">@settings.AboutParagraph2</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">About Us Paragraph 3</label>
                            <textarea name="AboutParagraph3" rows="2" class="form-control">@settings.AboutParagraph3</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Admin Username</label>
                            <input type="text" name="AdminUsername" class="form-control" value="@settings.AdminUsername" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Admin Password</label>
                            <input type="text" name="AdminPassword" class="form-control" value="@settings.AdminPassword" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-psl-primary px-4">
                                <i class="bi bi-save me-2"></i>Save All Settings
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

