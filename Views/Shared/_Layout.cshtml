@inject PslCoffeeCms.Services.CmsStoreService Store
@{
    var db = Store.GetDatabase();
    var settings = db.Settings;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @settings.CompanyName (@settings.BrandFull)</title>
    <link rel="icon" type="image/png" href="@settings.LogoUrl" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --psl-emerald: #0E2A1E;
            --psl-emerald-deep: #071911;
            --psl-espresso: #23140D;
            --psl-gold: #D4AF37;
            --psl-gold-light: #F3E5AB;
            --psl-gold-dark: #AA8222;
            --psl-cream: #FAF6F0;
            --psl-sand: #F2E9DC;
            --psl-text: #1E1612;
            --psl-muted: #6C5E56;
            --psl-border: #E5D9C5;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--psl-cream);
            color: var(--psl-text);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, .brand-serif {
            font-family: 'Cormorant Garamond', Georgia, serif;
            letter-spacing: 0.2px;
        }

        /* Top Announcement Ribbon */
        .topbar-psl {
            background: linear-gradient(90deg, var(--psl-emerald-deep) 0%, #143828 50%, var(--psl-emerald-deep) 100%);
            color: var(--psl-gold-light);
            font-size: 0.8rem;
            border-bottom: 1px solid rgba(212, 175, 55, 0.25);
            padding: 0.45rem 0;
        }

        /* Luxury Glass Navbar */
        .navbar-psl {
            background: rgba(14, 42, 30, 0.96);
            backdrop-filter: blur(14px);
            box-shadow: 0 10px 30px rgba(7, 25, 17, 0.28);
            border-bottom: 2px solid var(--psl-gold);
            padding-top: 0.8rem;
            padding-bottom: 0.8rem;
        }

        .navbar-psl .navbar-brand {
            color: #ffffff;
            font-weight: 700;
            font-size: 1.5rem;
        }

        .brand-logo-ring {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            padding: 2px;
            background: linear-gradient(135deg, var(--psl-gold), #FFF3B0, var(--psl-gold-dark));
            box-shadow: 0 0 18px rgba(212, 175, 55, 0.45);
            transition: transform 0.3s ease;
        }

        .navbar-brand:hover .brand-logo-ring {
            transform: rotate(-5deg) scale(1.06);
        }

        .navbar-psl .nav-link {
            color: rgba(250, 246, 240, 0.88);
            font-weight: 600;
            font-size: 0.94rem;
            padding: 0.55rem 1.25rem !important;
            border-radius: 50px;
            transition: all 0.25s ease;
            position: relative;
        }

        .navbar-psl .nav-link:hover,
        .navbar-psl .nav-link.active {
            color: var(--psl-emerald-deep);
            background: linear-gradient(135deg, var(--psl-gold-light) 0%, var(--psl-gold) 100%);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
        }

        /* Luxury Buttons */
        .btn-psl-gold {
            background: linear-gradient(135deg, #E5C158 0%, var(--psl-gold) 50%, var(--psl-gold-dark) 100%);
            color: var(--psl-emerald-deep);
            border: none;
            font-weight: 700;
            border-radius: 50px;
            padding: 0.65rem 1.6rem;
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.35);
            transition: all 0.25s ease;
        }

        .btn-psl-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(212, 175, 55, 0.5);
            color: #000;
        }

        .btn-psl-primary {
            background: linear-gradient(135deg, var(--psl-emerald) 0%, #1B4B35 100%);
            color: #fff;
            border: 1px solid rgba(212, 175, 55, 0.4);
            font-weight: 600;
            border-radius: 50px;
            padding: 0.6rem 1.5rem;
            transition: all 0.25s ease;
        }

        .btn-psl-primary:hover {
            background: linear-gradient(135deg, var(--psl-gold) 0%, var(--psl-gold-dark) 100%);
            color: var(--psl-emerald-deep);
            border-color: var(--psl-gold);
            transform: translateY(-2px);
        }

        .btn-psl-outline {
            background-color: transparent;
            color: var(--psl-emerald);
            border: 2px solid var(--psl-emerald);
            font-weight: 600;
            border-radius: 50px;
            padding: 0.55rem 1.4rem;
            transition: all 0.25s ease;
        }

        .btn-psl-outline:hover {
            background-color: var(--psl-emerald);
            color: var(--psl-gold-light);
            transform: translateY(-2px);
        }

        /* Hero Section */
        .hero-section {
            background:
                radial-gradient(circle at 80% 20%, rgba(212, 175, 55, 0.22), transparent 45%),
                linear-gradient(125deg, rgba(7, 25, 17, 0.95) 0%, rgba(14, 42, 30, 0.90) 55%, rgba(35, 20, 13, 0.92) 100%),
                url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
            color: var(--psl-cream);
            padding: 5.5rem 0;
            border-bottom: 3px solid var(--psl-gold);
            position: relative;
        }

        .hero-badge {
            background: rgba(212, 175, 55, 0.16);
            border: 1px solid var(--psl-gold);
            color: var(--psl-gold-light);
            font-weight: 600;
            padding: 0.45rem 1.15rem;
            border-radius: 50px;
            display: inline-block;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .hero-image-frame {
            padding: 12px;
            border-radius: 28px;
            background: linear-gradient(145deg, rgba(212, 175, 55, 0.45), rgba(255, 255, 255, 0.05));
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.45);
        }

        /* Cards & Sections */
        .product-card {
            background: #ffffff;
            border: 1px solid var(--psl-border);
            border-radius: 22px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
            box-shadow: 0 6px 20px rgba(30, 22, 18, 0.04);
        }

        .product-card:hover {
            transform: translateY(-7px);
            border-color: var(--psl-gold);
            box-shadow: 0 18px 38px rgba(14, 42, 30, 0.14);
        }

        .product-card-img {
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-card-img {
            transform: scale(1.07);
        }

        .price-pill {
            background: var(--psl-sand);
            color: var(--psl-emerald);
            font-weight: 800;
            padding: 0.35rem 0.9rem;
            border-radius: 50px;
            font-size: 1.05rem;
            border: 1px solid var(--psl-border);
        }

        .bg-psl-cream { background-color: var(--psl-sand); }
        .bg-psl-brown {
            background: linear-gradient(135deg, var(--psl-emerald-deep) 0%, var(--psl-emerald) 60%, var(--psl-espresso) 100%);
            color: var(--psl-cream);
        }

        .category-pill {
            border: 1.5px solid var(--psl-border);
            background-color: #ffffff;
            color: var(--psl-text);
            font-weight: 600;
            padding: 0.55rem 1.25rem;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
        }

        .category-pill:hover,
        .category-pill.active {
            background: linear-gradient(135deg, var(--psl-emerald) 0%, #1B4B35 100%);
            border-color: var(--psl-gold);
            color: var(--psl-gold-light);
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(14, 42, 30, 0.2);
        }

        /* Floating WhatsApp Button */
        .whatsapp-float {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1040;
            background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
            color: #fff;
            border-radius: 50px;
            padding: 0.75rem 1.25rem;
            font-weight: 700;
            box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.25s ease;
        }

        .whatsapp-float:hover {
            transform: translateY(-3px) scale(1.03);
            color: #fff;
            box-shadow: 0 14px 30px rgba(37, 211, 102, 0.55);
        }

        /* Footer */
        .footer-psl {
            background: linear-gradient(180deg, var(--psl-emerald-deep) 0%, #040F0A 100%);
            color: var(--psl-cream);
            border-top: 3px solid var(--psl-gold);
        }

        .footer-psl a { color: rgba(250, 246, 240, 0.8); text-decoration: none; transition: color 0.2s; }
        .footer-psl a:hover { color: var(--psl-gold); }
    </style>
</head>
<body>
    <!-- Top Info Bar -->
    <div class="topbar-psl d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-cup-hot-fill me-1 text-warning"></i>
                <strong>@settings.CompanyName</strong> — @settings.BrandFull • <em>Pour • Sip • Stay</em>
            </div>
            <div class="d-flex align-items-center gap-4">
                <span><i class="bi bi-telephone-fill me-1 text-warning"></i>Call: <a href="tel:@settings.Phone" class="text-white text-decoration-none fw-semibold">@settings.Phone</a></span>
                <span><i class="bi bi-whatsapp me-1 text-success"></i>WhatsApp: <a href="https://wa.me/@settings.WhatsAppNumber" target="_blank" class="text-white text-decoration-none fw-semibold">@settings.Phone</a></span>
            </div>
        </div>
    </div>

    <!-- Main Navigation (Clean Public Header — Admin & QA Buttons Removed) -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-psl">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-3" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-ring">
                        <img src="@settings.LogoUrl" alt="@settings.CompanyName" class="rounded-circle w-100 h-100" style="object-fit: cover;" />
                    </div>
                    <div class="d-flex flex-column lh-1">
                        <span class="brand-serif fs-3 fw-bold text-white">@settings.CompanyName</span>
                        <small class="fw-semibold" style="font-size: 0.68rem; color: var(--psl-gold); letter-spacing: 2px;">POUR • SIP • LEAF</small>
                    </div>
                </a>

                <div class="d-flex align-items-center gap-2 order-lg-3">
                    <a href="https://wa.me/@settings.WhatsAppNumber" target="_blank" class="btn btn-outline-light rounded-pill d-none d-xl-inline-flex align-items-center gap-2 py-2 px-3 border-opacity-25">
                        <i class="bi bi-whatsapp text-success"></i>
                        <span class="small fw-semibold">@settings.Phone</span>
                    </a>
                    <button class="btn btn-psl-gold d-flex align-items-center gap-2 py-2 px-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartDrawer">
                        <i class="bi bi-bag-heart-fill"></i>
                        <span>Order Cart</span>
                        <span id="cartCountBadge" class="badge rounded-pill bg-dark text-warning">0</span>
                    </button>
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#pslNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse order-lg-2" id="pslNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Menu" ? "active" : "")" asp-controller="Home" asp-action="Menu">Our Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Floating WhatsApp Quick Chat -->
    <a href="https://wa.me/@settings.WhatsAppNumber" target="_blank" class="whatsapp-float" title="Order on WhatsApp">
        <i class="bi bi-whatsapp fs-5"></i>
        <span class="d-none d-sm-inline">WhatsApp Order</span>
    </a>

    <!-- WhatsApp Cart Offcanvas Drawer -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerLabel">
        <div class="offcanvas-header bg-psl-brown text-white">
            <h5 class="offcanvas-title fw-bold brand-serif fs-4" id="cartDrawerLabel">
                <i class="bi bi-bag-heart-fill text-warning me-2"></i>Your Order Basket
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <div id="cartItemsList" class="flex-grow-1 overflow-auto mb-3"></div>
            <div class="border-top pt-3">
                <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                    <span>Total Amount:</span>
                    <span id="cartTotalDisplay" style="color: var(--psl-emerald);">@settings.Currency 0</span>
                </div>
                <div class="mb-3">
                    <input type="text" id="custName" class="form-control mb-2 rounded-3" placeholder="Your Full Name" />
                    <input type="text" id="custAddress" class="form-control rounded-3" placeholder="Table # or Delivery Address" />
                </div>
                <button type="button" class="btn btn-success w-100 fw-bold py-3 rounded-pill shadow" onclick="checkoutWhatsApp()">
                    <i class="bi bi-whatsapp me-2"></i>Place Order on WhatsApp (@settings.Phone)
                </button>
            </div>
        </div>
    </div>

    <footer class="footer-psl pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary border-opacity-25">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="brand-logo-ring">
                            <img src="@settings.LogoUrl" alt="@settings.CompanyName" class="rounded-circle w-100 h-100" style="object-fit: cover;" />
                        </div>
                        <div>
                            <h3 class="mb-0 text-white brand-serif fw-bold">@settings.CompanyName</h3>
                            <small style="color: var(--psl-gold); letter-spacing: 1px;">@settings.BrandFull</small>
                        </div>
                    </div>
                    <p class="small text-light opacity-75 mb-3" style="max-width: 440px;">@settings.AboutParagraph1</p>
                    <div class="d-flex gap-2">
                        <a href="https://wa.me/@settings.WhatsAppNumber" target="_blank" class="btn btn-sm btn-psl-gold px-3">
                            <i class="bi bi-whatsapp me-1"></i>WhatsApp Order
                        </a>
                        <a asp-controller="Home" asp-action="Menu" class="btn btn-sm btn-outline-light rounded-pill px-3">
                            Explore Full Menu
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold mb-3" style="color: var(--psl-gold); letter-spacing: 1px;">Quick Navigation</h6>
                    <ul class="list-unstyled d-grid gap-2 small">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i>Home</a></li>
                        <li><a asp-controller="Home" asp-action="Menu"><i class="bi bi-chevron-right small me-1"></i>Our Menu (@db.MenuItems.Count Items)</a></li>
                        <li><a asp-controller="Home" asp-action="About"><i class="bi bi-chevron-right small me-1"></i>About @settings.CompanyName</a></li>
                        <li><a asp-controller="Home" asp-action="Contact"><i class="bi bi-chevron-right small me-1"></i>Contact & Location</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-uppercase fw-bold mb-3" style="color: var(--psl-gold); letter-spacing: 1px;">Direct Contact</h6>
                    <ul class="list-unstyled small d-grid gap-2 mb-0">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill text-warning"></i>
                            <span>Call: <a href="tel:@settings.Phone" class="fw-semibold text-white">@settings.Phone</a></span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-whatsapp text-success"></i>
                            <span>WhatsApp: <a href="https://wa.me/@settings.WhatsAppNumber" target="_blank" class="fw-semibold text-white">@settings.Phone</a></span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-warning mt-1"></i>
                            <span>@settings.Address</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 small opacity-75">
                <div>&copy; @DateTime.Now.Year @settings.CompanyName — @settings.BrandFull. All rights reserved.</div>
                <div>Pour • Sip • Stay</div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const CMS_CURRENCY = '@settings.Currency';
        const CMS_WHATSAPP = '@settings.WhatsAppNumber';
        const CART_KEY = 'psl_mvc_cms_cart_v1';

        function getCart() {
            try { return JSON.parse(localStorage.getItem(CART_KEY) || '[]'); } catch { return []; }
        }
        function saveCart(cart) {
            localStorage.setItem(CART_KEY, JSON.stringify(cart));
            renderCart();
        }
        function addToCart(id, name, price) {
            const cart = getCart();
            const existing = cart.find(x => x.id === id);
            if (existing) existing.qty += 1;
            else cart.push({ id, name, price: Number(price), qty: 1 });
            saveCart(cart);
            const drawerEl = document.getElementById('cartDrawer');
            if (drawerEl) bootstrap.Offcanvas.getOrCreateInstance(drawerEl).show();
        }
        function changeQty(id, delta) {
            let cart = getCart();
            const item = cart.find(x => x.id === id);
            if (!item) return;
            item.qty += delta;
            if (item.qty <= 0) cart = cart.filter(x => x.id !== id);
            saveCart(cart);
        }
        function renderCart() {
            const cart = getCart();
            const count = cart.reduce((s, i) => s + i.qty, 0);
            const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
            document.getElementById('cartCountBadge').innerText = count;
            document.getElementById('cartTotalDisplay').innerText = `${CMS_CURRENCY} ${total}`;
            const container = document.getElementById('cartItemsList');
            if (!cart.length) {
                container.innerHTML = '<div class="text-center text-muted py-5"><i class="bi bi-cup-hot display-4 opacity-50"></i><p class="mt-2">Your order basket is empty.</p></div>';
                return;
            }
            container.innerHTML = cart.map(item => `
                <div class="d-flex justify-content-between align-items-center border-bottom py-3">
                    <div>
                        <div class="fw-bold">${item.name}</div>
                        <div class="text-muted small">${CMS_CURRENCY} ${item.price} × ${item.qty} = <strong class="text-dark">${CMS_CURRENCY} ${item.price * item.qty}</strong></div>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-dark" onclick="changeQty('${item.id}', -1)">−</button>
                        <button class="btn btn-outline-dark" onclick="changeQty('${item.id}', 1)">+</button>
                    </div>
                </div>
            `).join('');
        }
        function checkoutWhatsApp() {
            const cart = getCart();
            if (!cart.length) { alert('Please add items to your cart first.'); return; }
            const name = document.getElementById('custName').value || 'Valued Guest';
            const addr = document.getElementById('custAddress').value || 'Pickup / Dine-in';
            const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
            let lines = [`*New Order — @settings.CompanyName*`, `Customer: ${name}`, `Location: ${addr}`, `-------------------`];
            cart.forEach(i => lines.push(`• ${i.qty}x ${i.name} (${CMS_CURRENCY} ${i.price * i.qty})`));
            lines.push(`-------------------`, `*Total Payable: ${CMS_CURRENCY} ${total}*`);
            window.open(`https://wa.me/${CMS_WHATSAPP}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank');
        }
        document.addEventListener('DOMContentLoaded', renderCart);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
